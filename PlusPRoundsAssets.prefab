  m_Script: {fileID: 11500000, guid: b6dfc761da12d117d98deee3fee58a3b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  plus_p_rounds_entry:
    generate: 0
    name: ciarencew.+p_ammo
    info_sprite: {fileID: 21300000, guid: ffbd1986a20de74cc9d6349f36e53d13, type: 3}
    title: Overpressure Ammunition
    description: 'Some of our more advanced Receivers have opted to include overpressure
      ammunition (more commonly refered to as +P) in their caches. While our firearms
      training did not include using those types of ammunition -- you might be able
      to make good use of them. Due to their increased gunpowder load, the bullets
      fired from those rounds have higher velocity, and, commonly, higher mass. All
      this to say, whatever you hit, will get hit <u><b>hard</b></u>; A turret you
      graze might still topple over -- A shock drone you hit center mass might crash
      into a wall, disabling it.


      Despite these advantages over more "standard"
      rounds, you need to be aware that +P ammo also come with a lot more recoil
      than you might expect (my gun almost jumped out my hand the first time I shot
      one of those), and their increased pressure might prevent the gun from functioning
      properly, resulting in more frequent malfunctions.'
    locked_default: 1
    menu_entry_category: 4
  competition_rounds_entry:
    generate: 0
    name: ciarencew.-p_ammo
    info_sprite: {fileID: 21300000, guid: af2a87d66b080ba808d13be2d24e3549, type: 3}
    title: Underpressure Ammunition
    description: 'While standard and overpressure loads might be useful for self-defense,
      we recommend novice Receivers to practice their firearm drills using reduced-recoil
      loads. These loads have a lesser amount of gunpowder, and, more often that
      not, a lighter bullet. As the name suggests, this reduces the recoil exerted
      upon the gun when it fires. Such loads are also useful for competition matches,
      although so called "match grade" ammo usually have a heavier bullet. Do note
      however that while the gun will kick back with less force, so will the slide,
      which might cause the feed and eject mechanisms to fail.


      Obviously,
      this makes these rounds less effective against killdrones, so make sure to
      make your shots count.'
    locked_default: 1
    menu_entry_category: 4
  srab_tex: {fileID: 2800000, guid: e599c07d4afe91435b15e7b8afe22168, type: 3}
